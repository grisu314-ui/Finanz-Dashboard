# Settings of the Dockge stack on TrueNAS (E-21): copy into the stack's .env in Dockge and
# fill in the empty values. Secrets stay empty here; non-secret values are prefilled (E-12).
# Step-by-step instructions: docs/einrichtung.md. Never commit a filled-in copy.

# FRED API key (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Data directory: child dataset "data" of the project dataset (E-28), absolute path on TrueNAS.
# Must exist before the first start and belong to FEVER_UID:FEVER_GID.
FEVER_DATA_DIR=/mnt/Daten-Z1/apps/feewer/data

# User the containers run as: TrueNAS "apps" (E-29).
FEVER_UID=568
FEVER_GID=568

# Port of the dashboard in the home network (used from milestone M6 on).
FEVER_WEB_PORT=8003
