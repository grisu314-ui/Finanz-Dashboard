# Copy to .env and fill in the empty values: cp .env.example .env && chmod 600 .env
# Secrets stay empty here; non-secret values are prefilled (E-12).
# Step-by-step instructions: docs/einrichtung.md, step 6. Never commit .env.

# FRED API key (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Absolute host path of the data directory on a local filesystem (no NFS/SMB).
# Decided 26.09.2026 (E-11). Must exist before the first start and belong to FEVER_UID:FEVER_GID.
FEVER_DATA_DIR=/home/dirk/volumes/fever

# Owner of the data directory: output of `id -u` and `id -g` for user dirk on the Pi.
FEVER_UID=1000
FEVER_GID=1000

# Port of the dashboard in the home network.
FEVER_WEB_PORT=8050
