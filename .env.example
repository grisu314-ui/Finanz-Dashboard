# Copy to .env and fill in: cp .env.example .env && chmod 600 .env
# Step-by-step instructions: docs/einrichtung.md, step 6. Never commit .env.

# FRED API key (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Absolute host path of the data directory on a local filesystem (no NFS/SMB),
# e.g. /srv/fever/data. The directory must exist and belong to FEVER_UID:FEVER_GID.
FEVER_DATA_DIR=

# Owner of the data directory: output of `id -u` and `id -g` on the Pi (default 1000).
FEVER_UID=
FEVER_GID=

# Port of the dashboard in the home network (default 8050).
FEVER_WEB_PORT=
